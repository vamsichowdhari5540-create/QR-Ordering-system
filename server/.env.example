# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Postgres (Supabase) — use the Session pooler connection string from
# Project Settings -> Database -> Connect. It's IPv4-compatible, unlike the
# direct connection host, which matters for hosts like Render.
#
# DB_NAME separates environments: production uses `postgres`, local dev uses
# a second database (`food_politics_dev`) in the same project, so test orders
# never reach the real books. Create it once with:
#   CREATE DATABASE food_politics_dev;
# then run `npm run migrate` and `npm run seed` against it.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=
DB_NAME=food_politics_dev

# Supabase always requires TLS. Set to false only for a local Postgres with no TLS.
DB_SSL=true

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=12h

# Seed admin (used only by src/db/seed.js, not read at runtime)
SEED_ADMIN_EMAIL=owner@foodpolitics.local
SEED_ADMIN_PASSWORD=admin123

# Phone number protection
MOBILE_INDEX_KEY=replace_with_a_long_random_hex_string
ENCRYPTION_KEY=replace_with_a_32_byte_hex_string


# Tables
TOTAL_TABLES=15

# GST
CGST_RATE=2.5
SGST_RATE=2.5
GSTIN=37XXXXXXXXXXXZ5

SEED_SERVER_EMAIL=server@foodpolitics.local
SEED_SERVER_PASSWORD=server123

SEED_KITCHEN_EMAIL=kitchen@foodpolitics.local
SEED_KITCHEN_PASSWORD=kitchen123
