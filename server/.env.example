# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_politics

# Set DB_SSL=true for a managed host (Aiven, PlanetScale, etc). Leave DB_SSL_CA
# unset to accept the provider's default cert chain, or paste the provider's
# CA certificate contents to verify it strictly. Local XAMPP/MySQL needs neither.
DB_SSL=false
DB_SSL_CA=

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=12h

# Seed admin (used only by src/db/seed.js, not read at runtime)
SEED_ADMIN_EMAIL=owner@foodpolitics.local
SEED_ADMIN_PASSWORD=admin123

# Phone number protection
MOBILE_INDEX_KEY=replace_with_a_long_random_hex_string
ENCRYPTION_KEY=replace_with_a_32_byte_hex_string


# Tables
TOTAL_TABLES=15

# GST
CGST_RATE=2.5
SGST_RATE=2.5
GSTIN=37XXXXXXXXXXXZ5

SEED_SERVER_EMAIL=server@foodpolitics.local
SEED_SERVER_PASSWORD=server123

SEED_KITCHEN_EMAIL=kitchen@foodpolitics.local
SEED_KITCHEN_PASSWORD=kitchen123
